<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LandscapeManagement.Views.NewFolder2.BulkBookingDeletion"
    Title="Bulk Delete Bookings"
    BackgroundColor="#F9F9F9">

    <StackLayout Padding="20" Spacing="20">
        <!-- Navigation Button -->
        <Button Text="🏠 Home" Clicked="OnHomeClicked" 
                BackgroundColor="Transparent" TextColor="#007BFF" 
                HorizontalOptions="Start" FontAttributes="Bold"/>

        <!-- Heading -->
        <Label Text="Bulk Delete Bookings" 
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="#333"/>

        <!-- Select All and Deselect All Buttons -->
        <StackLayout Orientation="Horizontal" Spacing="20" HorizontalOptions="Center">
            <Button Text="Select All" Clicked="OnSelectAllClicked" 
                    BackgroundColor="#4CAF50" TextColor="White" WidthRequest="150"/>
            <Button Text="Deselect All" Clicked="OnDeselectAllClicked" 
                    BackgroundColor="#FFC107" TextColor="White" WidthRequest="150"/>
        </StackLayout>

        <!-- CollectionView for Displaying Bookings -->
        <CollectionView x:Name="BookingsCollectionView" 
                         SelectionMode="None" 
                         HeightRequest="400">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#FFFFFF" 
                           CornerRadius="12" 
                           Padding="15" 
                           Margin="5" 
                           HasShadow="True">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalOptions="Center"/>
                            <StackLayout Spacing="5" HorizontalOptions="FillAndExpand">
                                <Label Text="{Binding Service.service_name}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#333"/>
                                <Label Text="{Binding User.name}" 
                                       FontSize="14" 
                                       TextColor="#666"/>
                                <Label Text="{Binding booking_date, StringFormat='Booked on: {0:MMM dd, yyyy}'}" 
                                       FontSize="14" 
                                       TextColor="#666"/>
                                <Label Text="{Binding status}" 
                                       FontSize="14" 
                                       TextColor="#666"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Delete Button -->
        <Button Text="Delete Selected Bookings" 
                BackgroundColor="#F44336" 
                TextColor="White" 
                CornerRadius="10" 
                HeightRequest="50"
                Clicked="OnDeleteSelectedClicked"/>
    </StackLayout>
</ContentPage>